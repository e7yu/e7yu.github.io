{% for social in site.data.socials %}
  {% case social[0] %}
    {% when "email" %}
      <a href="mailto:{{ social[1] | encode_email }}" title="Email">
        <i class="fas fa-envelope" style="color:var(--global-theme-color)"></i>
      </a>
    {% when "linkedin_username" %}
      <a href="https://www.linkedin.com/in/{{ social[1] }}" title="LinkedIn" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-linkedin" style="color:#0a66c2"></i>
      </a>
    {% when "github_username" %}
      <a href="https://github.com/{{ social[1] }}" title="GitHub" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-github" style="color:var(--global-text-color)"></i>
      </a>
    {% when "twitter_username" %}
      <a href="https://twitter.com/{{ social[1] }}" title="Twitter" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-x-twitter"></i>
      </a>
    {% when "instagram_username" %}
      <a href="https://instagram.com/{{ social[1] }}" title="Instagram" target="_blank" rel="noopener noreferrer">
        <i class="fab fa-instagram"></i>
      </a>
    {% when "scholar_userid" %}
      <a href="https://scholar.google.com/citations?user={{ social[1] }}" title="Google Scholar" target="_blank" rel="noopener noreferrer">
        <i class="ai ai-google-scholar" style="color:#4285f4"></i>
      </a>
    {% when "orcid_id" %}
      <a href="https://orcid.org/{{ social[1] }}" title="ORCID" target="_blank" rel="noopener noreferrer">
        <i class="ai ai-orcid" style="color:#a6ce39"></i>
      </a>
    {% when "custom_social" %}
      <a href="{{ social[1].url }}" title="{{ social[1].title }}">
        <img src="{{ social[1].logo }}" alt="{{ social[1].title }}" class="social-icon">
      </a>
  {% endcase %}
{% endfor %}
