@article{art1,
  author   = {Dai, J. and Rayana, N. P. and Peng, M. and Sugali, C. K. and Harvey, D. H. and Dhamodaran, K. and Yu, E. and Dalloul, J. M. and Liu, S. and Mao, W.},
  title    = {{Inhibition of pterygium cell fibrosis by the Rho kinase inhibitor}},
  journal  = {Sci. Rep.},
  volume   = {14},
  pages    = {30930},
  year     = {2024},
  keywords = {J},
  doi      = {10.1038/s41598-024-81659-6},
  pdf      = {pterygium_rho_kinase.pdf},
  preview  = {pterygium_rk_img.webp},
  abbr     = {Sci. Rep.},
  abstract = {Pterygium is an ocular disease in which the conjunctival tissue invades the cornea. When the pterygium tissue reaches the pupillary region, the visual function of the patient is affected. Currently, surgical removal is the only effective treatment. However, the recurrence rate of pterygium after surgery can be high. Pterygium is also a health disparity issue since it is more prevalent in the Hispanic and Latino American population. In this study, we determined if the Rho kinase inhibitor can be used to prevent pterygium recurrence since its anti-fibrosis effects have been reported in other cell and tissue types. We cultured primary pterygium cells from pterygium tissues from Hispanic and Latino American, African American, Caucasian, and Asian donors, and used those cells for viability assays, scratch assays, migration assays, and immunostaining of F-actin, fibronectin, collagen I and α smooth muscle actin. We found that the Rho kinase inhibitor Y27632 decreased cell viability, wound healing, cell migration, as well as the expression of extracellular matrix and myofibroblast markers in cultured pterygium cells. We believe that Rho kinase inhibitors are a potential post-surgical treatment to prevent pterygium recurrence.}
}


@article{Conf1,
  author   = {Dai, J. and Rayana, N. P. and Peng, M. and Sugali, C. K. and Harvey, D. H. and Dhamodaran, K. and Yu, E. and Dalloul, J. M. and Liu, S. and Mao, W.},
  title    = {{The Rho kinase inhibitor Y27632 inhibits unstimulated pterygium cell fibrosis}},
  journal  = {Invest. Ophthalmol. Vis. Sci.},
  volume   = {66},
  pages    = {6114},
  year     = {2025},
  keywords = {C},
  abbr     = {IOVS},
  link     = {https://iovs.arvojournals.org/article.aspx?articleid=2809016},
  preview  = {rk_abs.webp},
  addendum = {2025 ARVO Annual Meeting in Salt Lake City, UT, May 4--8, 2025},
  abstract = {Pterygium is a triangular shaped conjunctival tissue growing onto the cornea. It affects patient visual function when tissue reaches the pupillary region. The disease is also a health disparity issue in the US since it is more common in Hispanic and Latino populations. Currently, surgery is the only effective treatment. However, the recurrence rate after pterygium surgery is high. To prevent pterygium recurrence, we determined if the Rho kinase inhibitor can be used to prevent pterygium recurrence.
\n\nThe study was approved by Indiana University School of Medicine IRB. Patient data representing the prevalence of the disease in the US population. Pterygium explants were dissected and cultured to establish primary human pterygium cell (PHPC) strains. The Rho kinase inhibitor Y27632 and mitomycin C (MMC) were tested at different treatment concentrations. Cell viability assays (XTT assays), scratch assays, migration assays, immunostainings were used to evaluate cell proliferation, migration, and fibrotic markers.
\n\nWe found that Y27632 dose-dependently decreased PHPT cell viability similar to MMC. It delayed wound healing, which was reversible, in the scratch assay, and also reduced PHPT cell migration. Y27632 inhibited the actin polymerization as well as extracellular matrix proteins and a-smooth muscle actin.
\n\nY27632 showed promising anti-fibrotic effects in pterygium cells from US donors. The rho kinase inhibitor may have the potential for clinical applications.}
}

@article{Conf2,
  author   = {Sugali, C. K. and Dhamodaran, K. and Dai, J. and Harvey, D. H. and Pushpala, N. M. and Yu, E. and Huynh, K. and Huang, A. Y. and Mao, W.},
  journal  = {Invest. Ophthalmol. Vis. Sci},
  number   = {},
  title    = {Canonical Wnt signaling pathway inhibits glucocorticoid-induced ocular hypertension without compromising its anti-inflammatory function in the uveitis mouse model},
  volume   = {},
  year     = {2026},
  keywords = {C},
  abbr     = {IOVS},
  addendum = {2026 ARVO Annual Meeting in Denver, CO, May 3--7, 2026},
  abstract = {Glucocorticoids (GCs) are anti-inflammatory treatments for many ocular diseases. Prolonged GC use causes elevated intraocular pressure (IOP) in about 40% of the population, known as GC-induced ocular hypertension (GIG). Our published studies suggested that inhibition of canonical Wnt signaling plays a role in GC-induced OHT, and we hypothesize that activation of canonical Wnt signaling inhibits the side effects of steroids without compromising their therapeutic effects.
\n\nC57BL/6J, TCF-GFP and floxed β-catenin mice were injected with dexamethasone-acetate (DEX) and/or lenti-Cre/GFP. After development of OHT, the mice were treated with CHIR (the Wnt activator), PBS, lenti-Dkk1 shRNA or lenti-nontargeting shRNA. Human corneas were perfused with DEX to identify if they were GC responders or non-responders. The corneas were then treated with or without CHIR or Dkk1 recombinant protein. Some C57BL/6J mice were injected with lipopolysaccharide while some were injected with interphotoreceptor retinoid binding protein and pertussis toxin to develop endotoxin-induced uveitis (EIU) and experimental autoimmune uveitis (EAU), respectively. Mouse tissues were collected for analysis, and a scoring system was used to evaluate uveitis based on mouse fundus images and OCT findings.
\n\nThe TCF-GFP mice receiving DEX showed OHT compared to control mice, whereas those receiving CHIR or lenti-Dkk1 shRNA and DEX showed a significant decrease in IOP compared to the DEX alone mice. Immunostaining showed an increase in Wnt signaling-driven GFP expression in the eyes with canonical Wnt signaling activation. Further, β-catenin conditional knockout mice receiving DEX still developed OHT upon CHIR treatment. DEX responder human donor eyes developed DEX-induced OHT and this OHT was inhibited by CHIR. In contrast, DEX non-responder eyes did not develop DEX-induced OHT but co-treatment with Dkk1 induced OHT in the same eyes. Mouse EIU or EAU were alleviated by DEX or DEX+CHIR similarly.
\n\nOverall, our data suggest that it is the canonical Wnt signaling pathway that inhibits GC-induced OHT without compromising GC’s anti-inflammatory activity. Manipulation of this pathway may also reverse GC responsiveness.}
}
